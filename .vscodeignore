# Files excluded from the packaged .vsix.
#
# NOTE: backend/** is deliberately NOT excluded. The Python backend ships
# inside the extension and is launched from the extension install directory.

.vscode/**
.vscode-test/**
.github/**

# TypeScript sources - only the compiled dist/ output is shipped.
**/*.ts
**/*.map
tsconfig.json

# Python build/dev artefacts that must never reach the .vsix.
**/__pycache__/**
**/*.pyc
.venv/**
venv/**
tests/**
pytest.ini
pyproject.toml
.vectorai_db/**
.codelens_index/**

# Developer tooling and local config.
node_modules/.bin/**
setup.sh
start.sh
docker-compose.yml
.env
.env.example
.gitignore
