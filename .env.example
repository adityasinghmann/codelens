# Environment Configuration for CodeLens Backend
# Copy this to .env and adjust values

# Directory holding the local index (SQLite file + WAL).
# The old name VECTORAI_DB_PATH is still honoured if set.
CODELENS_INDEX_PATH=./.codelens_index

# Ollama server address (default: local)
OLLAMA_HOST=http://localhost:11434

# Embedding model (nomic-embed-text gives 768-dim vectors, ~274MB)
EMBED_MODEL=nomic-embed-text

# Max tokens per chunk (safety cap)
CHUNK_SIZE=512

# Number of results to return per query
TOP_K=10

# Model used for optional "explain" summaries
EXPLAIN_MODEL=mistral
