{
  "name": "codelens",
  "displayName": "CodeLens — Offline Semantic Search",
  "description": "Natural-language semantic search for your codebase. 100% offline, powered by Actian VectorAI DB + Ollama.",
  "version": "0.2.0",
  "publisher": "nikhilmourya",
  "repository": {
    "type": "git",
    "url": "https://github.com/TryingtobeingNikhil/CodeLens.git"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "semantic search",
    "code search",
    "offline",
    "AI",
    "vector database"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codelens-sidebar",
          "title": "CodeLens Search",
          "icon": "media/codelens-icon.svg"
        }
      ]
    },
    "views": {
      "codelens-sidebar": [
        {
          "type": "webview",
          "id": "codelens.sidebar",
          "name": "Semantic Search"
        }
      ]
    },
    "commands": [
      {
        "command": "codelens.search",
        "title": "CodeLens: Semantic Search",
        "icon": "$(search)"
      },
      {
        "command": "codelens.reindex",
        "title": "CodeLens: Re-index Workspace",
        "icon": "$(sync)"
      },
      {
        "command": "codelens.showStatus",
        "title": "CodeLens: Show Status"
      },
      {
        "command": "codelens.restartBackend",
        "title": "CodeLens: Restart Backend",
        "icon": "$(debug-restart)"
      }
    ],
    "configuration": {
      "title": "CodeLens",
      "properties": {
        "codelens.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to a Python 3.10+ interpreter used to build the backend's virtual environment. Leave empty to search `PATH` and then the standard install locations for your platform."
        },
        "codelens.ollamaPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `ollama` executable. Leave empty to search `PATH` and then the standard install locations for your platform. Only used to put Ollama on the backend's `PATH`; the backend itself talks to Ollama over HTTP at `#codelens.ollamaHost#`."
        },
        "codelens.ollamaHost": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Address of the Ollama server that generates embeddings."
        },
        "codelens.port": {
          "type": "integer",
          "default": 8000,
          "minimum": 1,
          "maximum": 65535,
          "description": "Loopback port the bundled CodeLens backend listens on."
        },
        "codelens.startupTimeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "How long to wait for the backend to answer /health before reporting a startup failure."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "codelens.reindex",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build":            "tsc -p ./",
    "watch":            "tsc -watch -p ./",
    "compile":          "tsc -p ./",
    "vscode:prepublish": "npm run compile",
    "package":          "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.86.0",
    "@types/node": "18.x",
    "typescript": "^5.3.3",
    "@vscode/vsce": "^3.0.0"
  },
  "dependencies": {
    "axios": "^1.6.8"
  }
}
